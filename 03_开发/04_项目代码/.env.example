# 配置模板：复制本文件为 .env 后按需修改
# 说明：本地检索不依赖外部 API，无需密钥；检索来源为同目录 knowledge_base.json

# 检索返回条数
TOP_K=6
# 相关度低于该值判定为“资料可能未覆盖”（结果不展示、提示无法确认）
LOW_CONFIDENCE_THRESHOLD=0.20
# 统计“相关内容”条数的明确相关度下限
RELEVANT_FLOOR=0.60
# 问题长度上限（字符），超出拦截
MAX_QUESTION_LEN=500
# 资料版本（随每条结果展示，便于复核）
KB_VERSION=2026-10
# 服务监听地址与端口（0.0.0.0 满足局域网访问要求）
HOST=0.0.0.0
PORT=8000
